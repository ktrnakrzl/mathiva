# Copy this file to `.env` and fill in real values. `.env` is gitignored and
# must never be committed -- it holds secrets.

# SQLAlchemy database URL. Default (if unset) is a local SQLite file.
DATABASE_URL=sqlite:///./mathiva.db

# Secret used to sign/verify JWT access tokens (HS256). Generate a strong
# random value, e.g.:  python -c "import secrets; print(secrets.token_hex(32))"
# Tokens signed with this can authenticate as any user, so keep it secret and
# rotate it if it ever leaks.
JWT_SECRET=replace-with-a-long-random-hex-string

# Mathpix OCR credentials (https://mathpix.com -> Console -> API keys). When
# both are set, the /solve-image scanner uses Mathpix, which reads *handwritten*
# math. If unset, it falls back to the local pix2tex model (printed math only).
MATHPIX_APP_ID=
MATHPIX_APP_KEY=
