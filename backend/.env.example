# Copy this file to `.env` and fill in real values. `.env` is gitignored and
# must never be committed -- it holds secrets. Every value here has a safe
# default in app/config.py, so a local dev machine can run with an empty .env.

# ---------------------------------------------------------------------------
# Environment: "development" (default) or "production".
# In production, app startup (validate_runtime) REFUSES to boot if the JWT
# secret is the dev default / too short, or if DATABASE_URL is still SQLite.
# Leave as development locally so the zero-setup defaults keep working.
# ---------------------------------------------------------------------------
ENVIRONMENT=development

# ---------------------------------------------------------------------------
# Database (SQLAlchemy URL). Default (if unset) is a local SQLite file.
# Locally: leave unset / SQLite -- tables auto-create on startup.
# Production (Supabase Postgres): set this to the project's connection string
# and run `alembic upgrade head` to create the schema (create_all is skipped
# on Postgres -- Alembic is the source of truth). Example:
#   DATABASE_URL=postgresql://postgres:<password>@<host>:5432/postgres
# Supabase requires TLS; append ?sslmode=require if the connect is rejected.
DATABASE_URL=sqlite:///./mathiva.db

# ---------------------------------------------------------------------------
# Auth / JWT.
# Secret used to sign/verify JWT access tokens (HS256). Generate a strong
# random value (>= 32 bytes, enforced in production), e.g.:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Tokens signed with this can authenticate as any user, so keep it secret and
# rotate it if it ever leaks.
JWT_SECRET=replace-with-a-long-random-hex-string
# Signing algorithm and access-token lifetime (minutes). Defaults are fine.
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Google Sign-In. Use the Web application client ID from Google Cloud Console.
GOOGLE_CLIENT_ID=

# Public frontend origin. Password reset emails link to:
#   FRONTEND_URL/reset-password?token=...
FRONTEND_URL=http://localhost:3000

# SMTP for password reset emails. These can point at Gmail app passwords,
# Brevo, Mailgun, Resend SMTP, etc. Without SMTP, reset requests are accepted
# generically but no email can be delivered.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Mathiva
SMTP_USE_TLS=true

# ---------------------------------------------------------------------------
# OpenAI API. Used by /solve-image for camera/gallery math and by the /ask chat
# cascade. This stays on the backend and must never be bundled into Flutter.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
# Usually leave this unchanged. It is configurable for compatible gateways.
OPENAI_BASE_URL=https://api.openai.com/v1

# ---------------------------------------------------------------------------
# Skip the fine-tuned T5 tier in the /ask cascade.
# Set true in the HOSTED (Gemini-backed, no-Ollama) deployment: with no Phi-3
# there, T5 would be the primary local tutor, but at its current quality it can
# emit wrong/degenerate answers that slip past the guard and block Gemini.
# Leave false (default) for local dev / the defense demo, where T5 is showcased.
# ---------------------------------------------------------------------------
DISABLE_T5=false

# Local Ollama/Phi tutor. Hosted deployments without an Ollama sidecar should
# set DISABLE_OLLAMA=true so /ask skips localhost immediately and uses Gemini /
# fallback tiers. For laptop/offline demos with Ollama running, leave it false
# and set ENABLE_OLLAMA_STREAM=true so chat shows tokens as they arrive.
DISABLE_OLLAMA=false
ENABLE_OLLAMA_STREAM=false
OLLAMA_NUM_PREDICT=180

# Skip pix2tex's local OCR fallback. Set true on hosted/Render deployments so
# image solving uses Gemini OCR instead of downloading ~100 MB of model weights
# on the first request. Leave false locally if you want an offline fallback.
DISABLE_PIX2TEX=false
