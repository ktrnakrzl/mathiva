# Keep the build context small and secrets out of the image.
.git/
.github/
.claude/
.plans/

# The Flutter app is built + deployed separately, not in this image.
frontend/

# The ~1 GB fine-tuned T5 model + training data are not used in this deployment
# (T5 tier disabled; tutor falls back to Gemini). RAG's retrieval/ + solver/ are
# copied explicitly by the Dockerfile, so excluding these does not affect them.
ml/t5/
ml/data/

# Local Python / virtualenvs / caches.
.venv/
venv/
**/__pycache__/
**/*.pyc
**/*.pyo

# Secrets and local databases must never enter the image.
backend/.env
backend/.env.*
!backend/.env.example
*.db
*.sqlite3

# Editor / OS cruft and docs (not needed to build).
.dart_tool/
node_modules/
*.log
*.md
!DEPLOY.md
