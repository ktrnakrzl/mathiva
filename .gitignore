# Python cache
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
ENV/
env/

# Distribution / packaging
build/
dist/
*.egg-info/
.eggs/

# Logs and databases
*.log
*.sqlite3
*.db

# IDE / editor files
.vscode/
.idea/
*.suo
*.user
*.userosscache
*.sln.docstates

# OS files
.DS_Store
Thumbs.db

# Backend specific
backend/__pycache__/
backend/app/__pycache__/
backend/app/api/__pycache__/
backend/app/services/__pycache__/

# ML / data artifacts
ml/__pycache__/
ml/retrieval/__pycache__/
ml/embeddings/

# Flutter / Dart build outputs
**/build/
**/.dart_tool/
**/.flutter-plugins
**/.flutter-plugins-dependencies
**/generated_plugin_registrant.dart

# Local environment files
.env
*.env

# Temporary files
*.tmp
*.temp
*~

# Ignore compiled Python extensions
*.so
*.dylib
*.dll

# Python bytecode (any package)
**/__pycache__/

# Claude Code local state (memory, plans, settings)
.claude/

# Fine-tuned T5 model (large; produced by Colab train, downloaded locally)
ml/t5/model/
ml/t5/model_stageA/
ml/t5/mathiva_t5_model.zip

# DeepMind generic-math warm-up data (large; regenerate via ml/t5/deepmind/load_data.py)
ml/t5/deepmind/*.jsonl
ml/t5/deepmind/*.csv
ml/t5/deepmind/*.zip

# Dataset-pipeline backups and resume/cache files (regenerated)
ml/retrieval/*.backup.*
ml/retrieval/_qa_progress.json
ml/retrieval/_judge_verdicts.json
